diff --git a/test/sql/data_inlining/data_inlining_expression_projection.test b/test/sql/data_inlining/data_inlining_expression_projection.test
new file mode 100644
index 0000000..e180f4c
--- /dev/null
+++ b/test/sql/data_inlining/data_inlining_expression_projection.test
@@ -0,0 +1,88 @@
+# name: test/sql/data_inlining/data_inlining_expression_projection.test
+# description: Inlined filter expressions use physical column ids with sparse and reordered projections
+# group: [data_inlining]
+
+require ducklake
+
+require parquet
+
+require icu
+
+test-env DUCKLAKE_CONNECTION __TEST_DIR__/{UUID}.db
+
+test-env DATA_PATH __TEST_DIR__
+
+statement ok
+SET TimeZone = 'UTC'
+
+statement ok
+ATTACH 'ducklake:${DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '${DATA_PATH}/inlining_expression_projection', DATA_INLINING_ROW_LIMIT 100)
+
+statement ok
+CREATE TABLE ducklake.records(id INTEGER, pad1 VARCHAR, pad2 INTEGER, pad3 VARCHAR, event_at TIMESTAMP)
+
+statement ok
+INSERT INTO ducklake.records VALUES (1, 'a', 10, 'x', TIMESTAMP '2000-01-01'), (2, 'b', 20, 'y', TIMESTAMP '2001-01-01'), (3, 'c', 30, 'z', NULL), (4, 'd', 40, 'w', TIMESTAMP '2002-01-01')
+
+query I
+SELECT count(*) FROM ducklake.records WHERE filename = 'ducklake_inlined_data_1_1'
+----
+4
+
+statement ok
+ALTER TABLE ducklake.records ALTER event_at SET DATA TYPE TIMESTAMPTZ
+
+# This widening cast cannot push the TIMESTAMPTZ filter into the old TIMESTAMP
+# column directly. The reader must evaluate the cast expression before filtering.
+# Only physical column 4 is projected: indexing column_indexes by that physical
+# id instead of the scan position would read outside the projection list.
+query T
+SELECT event_at::DATE FROM ducklake.records WHERE event_at >= TIMESTAMPTZ '2001-01-01 00:00:00+00' ORDER BY event_at
+----
+2001-01-01
+2002-01-01
+
+query TI
+SELECT event_at::DATE, id FROM ducklake.records WHERE event_at >= TIMESTAMPTZ '2001-01-01 00:00:00+00' ORDER BY id
+----
+2001-01-01	2
+2002-01-01	4
+
+# Also cover a filter column that is not part of the result projection.
+query I
+SELECT id FROM ducklake.records WHERE event_at >= TIMESTAMPTZ '2001-01-01 00:00:00+00' ORDER BY id
+----
+2
+4
+
+statement ok
+CALL ducklake_flush_inlined_data('ducklake')
+
+query TI
+SELECT event_at::DATE, id FROM ducklake.records WHERE event_at >= TIMESTAMPTZ '2001-01-01 00:00:00+00' ORDER BY id
+----
+2001-01-01	2
+2002-01-01	4
+
+# The transaction-local reader uses a different scan setup but the same
+# expression executor map; it must preserve the same sparse projection mapping.
+statement ok
+CREATE TABLE ducklake.local_records(id INTEGER, pad1 VARCHAR, pad2 INTEGER, pad3 VARCHAR, event_at TIMESTAMP)
+
+statement ok
+BEGIN
+
+statement ok
+INSERT INTO ducklake.local_records VALUES (1, 'a', 10, 'x', TIMESTAMP '2000-01-01'), (2, 'b', 20, 'y', TIMESTAMP '2001-01-01'), (3, 'c', 30, 'z', NULL), (4, 'd', 40, 'w', TIMESTAMP '2002-01-01')
+
+statement ok
+ALTER TABLE ducklake.local_records ALTER event_at SET DATA TYPE TIMESTAMPTZ
+
+query TI
+SELECT event_at::DATE, id FROM ducklake.local_records WHERE event_at >= TIMESTAMPTZ '2001-01-01 00:00:00+00' ORDER BY id
+----
+2001-01-01	2
+2002-01-01	4
+
+statement ok
+ROLLBACK
